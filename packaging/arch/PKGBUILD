# Maintainer: Nguyễn Hồng Hiệp
#
# Builds jotty from a release tarball. The release workflow builds it from
# the tagged source with the version filled in; it also works for the AUR.

pkgname=jotty
pkgver=0.1.0
pkgrel=1
pkgdesc='A minimal, Wayland-native terminal emulator'
arch=('x86_64' 'aarch64')
url='https://github.com/justanoobcoder/jotty'
license=('MIT')
depends=('gcc-libs' 'glibc' 'wayland' 'libxkbcommon' 'libglvnd' 'fontconfig')
makedepends=('cargo' 'ncurses')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')
options=('!debug' '!strips')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
  tic -x -o target/terminfo extra/jotty.terminfo
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/jotty -t "$pkgdir/usr/bin"
  install -Dm644 target/terminfo/j/jotty -t "$pkgdir/usr/share/terminfo/j"
  install -Dm644 extra/jotty.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 README.md docs/*.md docs/config.example.toml -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
